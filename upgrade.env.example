# Copy outside this repository, then use:
#   ./upgrade-to-aistor.sh backup --config /secure/aistor-upgrade.env --confirm-permanent
# This file contains no mc credentials. The script uses the existing alias in
# the current user's mc configuration.

# The existing Linux service and binary path on BOTH nodes.
MINIO_SERVICE_NAME=minio
MINIO_BINARY_PATH=/usr/local/bin/minio

# Existing mc alias pointing at the cluster being upgraded. Do not run the
# backup/restart phases with sudo unless root owns this same configured alias.
MC_ALIAS=legacy-minio

# Required only for restart-and-license. The script registers it cluster-wide;
# no MINIO_LICENSE environment variable or per-node license copy is needed.
AISTOR_LICENSE_FILE=/secure/minio.license

# Optional. The script selects an URL based on uname -m if unset.
# AISTOR_ARCH=linux-amd64
# AISTOR_BINARY_URL=https://dl.min.io/aistor/minio/release/linux-amd64/minio
# AISTOR_BINARY_FILE=/secure/artifacts/aistor-minio  # air-gapped alternative

# Required for backup in production: an existing durable, access-restricted path.
# AISTOR_BACKUP_DIR=/secure/backups/minio-to-aistor-20260921
